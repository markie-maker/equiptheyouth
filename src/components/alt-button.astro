---
import '../styles/global.css'

interface Props {
    href: string;
    classes?: string;
    hoverAnim?: boolean;
}

const { href, classes = '', hoverAnim = false, ...rest } = Astro.props
---

<a href={href} class={
    `min-w-45 w-full sm:w-auto inline-flex items-center justify-center gap-2 whitespace-nowrap py-4 md:px-12 px-10 rounded-full bold text-sm sm:text-base text-[#222222] ${classes} ${hoverAnim ? "flex hover:gap-4 transition-all duration-300 ease-in-out hover:scale-105" : ""}`}
    {...rest}
    >
    <slot />
</a>