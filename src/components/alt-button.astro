---
import '../styles/global.css'

interface Props {
    href: string;
    classes?: string;
}

const { href, classes = '', ...rest } = Astro.props
---

<a href={href} class={
    `inline-flex items-center justify-center gap-2 whitespace-nowrap py-4 px-12 rounded-full bold text-[#222222] ${classes}`}
    {...rest}
    >
    <slot />
</a>