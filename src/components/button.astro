---
import '../styles/global.css'

interface Props {
    href: string;
    classes?: string;
    [key: string]: any; 
}

const { href, classes = '', ...rest } = Astro.props
---

<a 
    {...rest}
    href={href} class={
    `min-w-38 inline-flex items-center justify-center gap-2 whitespace-nowrap md:w-auto w-full py-4 md:px-12 px-10 rounded-full bold text-sm sm:text-base bg-[#222222] text-white button hover:shadow-md ${classes}`}
    >
    <slot />
</a>