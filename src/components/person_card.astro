---
import { Picture } from 'astro:assets'

interface Props {
    name: string
    role: string
    role_description: string
    image: ImageMetadata
}

const { name, role, role_description, image } = Astro.props
---

<div class="p-6 flex flex-col gap-4 items-center max-w-100">
    <Picture 
        src={image} 
        formats={['avif', 'webp']} 
        class=`w-full object-cover object-center image`
        data-aos="zoom-in"
        data-aos-duration="1000"
        data-aos-delay="100"
        pictureAttributes={{ class: `aspect-square max-h-50 max-w-50 display-block flex items-center rounded-full overflow-hidden relative image-wrapper` }}
        loading={'lazy'}
        quality={75}
        alt=`Portrait of ${name}, team member at Equip the Youth`
    />
    <h3 class="text-center text-3xl heading">{name}</h3>
    <p class="light text-center">{role}</p>
    <p class="text-center">{role_description}</p>
</div>
