---
import '../styles/global.css'
import 'aos/dist/aos.css'
import Logo from '../assets/ETY.svg'
import FooterMarquee from '../components/footerMarquee.svelte';
import FooterETY from '../assets/ETYfooter.svg'

import Facebook from '../assets/logos/facebook.svg'
import Instagram from '../assets/logos/instagram.svg'
import Nextdoor from '../assets/logos/nextdoor.svg'
import NavbarAstroComponent from '../components/navbar.svelte';
---

<html>
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Equip The Youth</title>
  </head>
  <body>

      <NavbarAstroComponent client:load/>

    <slot />

    <footer class="flex justify-between items-end w-full bg-[#f1f1f1] h-[50dvh] max-125 min-h-fit">
        <div class="max-w-1/3 max-h-125 box-border p-4">
          <FooterETY class="w-full h-auto block" />
        </div>
       <div class="flex flex-col gap-15 pb-4">
        <div class="flex flex-col text-xl gap-1 flex-wrap">
          <!-- CHANGE THIS TO HOME -->
          <a href="/" class="light button text-[#222222]">Home</a>
          <a href="/" class="light button text-[#222222]">About</a>
          <a href="/" class="light button text-[#222222]">Meet the Team</a>
          <a href="/" class="light button text-[#222222]">Our Goals</a>
          <a href="/" class="light button text-[#222222]">Donate Now</a>
          <a href="/" class="light button text-[#222222]">FAQs</a>

          <div class="flex gap-2">
            <a href="/" class="button flex items-center" aria-label="facebook logo"><Facebook /></a>
            <a href="/" class="button flex items-center" aria-label="instagram logo"><Instagram /></a>
            <a href="/" class="button flex items-center" aria-label="nextdoor logo"><Nextdoor /></a>
          </div>
          </div>

          <a href="/" class="underline text-xl light">Privacy Policy</a>
        </div>

        <FooterMarquee client:visible/>
    </footer>

    <script type="module">
      import initAOS from '../components/AOSInit.ts'
      initAOS()
    </script>
  </body>
</html>
