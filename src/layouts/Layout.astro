---
import '../styles/global.css'
import 'aos/dist/aos.css'
import FooterMarquee from '../components/footerMarquee.svelte'
import FooterETY from '../assets/ETYfooter.svg'
import etyIcon from '../assets/logo.ico'
import Section from '../layouts/Section.astro'

import SocialsAstroComponent from '../components/socials.astro'
import NavbarAstroComponent from '../components/navbar.svelte'
import Map from '../components/map.svelte'

interface Props {
  title: string
}
const { title } = Astro.props

---

<html lang="en" class="scroll-smooth">
  <head>
    <link rel="preload" href="/fonts/inter-v20-latin-300.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/inter-v20-latin-regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/inter-v20-latin-700.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/urbanist-v18-latin-500.woff2" as="font" type="font/woff2" crossorigin>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Equip The Youth - {title}</title>
    <meta name="description" content="Empowering young athletes across the Temecula Valley region. Equip the Youth collects and restores used sports gear for local families in need.">

    <link rel="icon" type="image/x-icon" href={etyIcon}>
  </head>
  <body class="scrollbar-thin [scrollbar-color:#222222#f1f1f1] [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-track]:bg-[#f1f1f1] [&::-webkit-scrollbar-thumb]:bg-[#222222] [&::-webkit-scrollbar-thumb]:rounded-full">

    <NavbarAstroComponent client:load/>

    <slot />

    <Section>
      <div class="flex justify-between gap-4">
        <div class="flex flex-col gap-4" data-aos="fade-up" data-aos-duration="500" data-aos-easing="ease-out-cubic" data-aos-delay="100">
          <h2 class="text-6xl heading text-[#222222] w-full text-left" >Let's Stay in Touch</h2>
          <p class="light text-2xl text-[#222222] w-full text-left mb-12">Follow our socials.</p>
          <p class="text-xl text-[#222222]">
            Email, follow, or look us up on Nextdoor to stay involved. Equip the Youth can help you support your community.
          </p>
          <a href="mailto:info@equiptheyouth.org" class="w-fit underline text-xl light">info@equiptheyouth.org</a>
          <SocialsAstroComponent />
        </div>
        <div>
          <Map client:visible/>
        </div>
      </div>
    </Section>

    <footer class="flex justify-between items-end w-full bg-[#f1f1f1] h-[50dvh] max-125 min-h-fit">
        <div class="max-w-1/3 max-h-125 box-border p-4">
          <FooterETY class="w-full h-auto block" />
        </div>
       <div class="flex flex-col gap-15 pb-4">
        <div class="flex flex-col text-xl gap-1 flex-wrap">

          <a href="/" class="light button text-[#222222]">Home</a>
          <a href="#about" class="light button text-[#222222]">About</a>
          <a href="#meettheteam" class="light button text-[#222222]">Meet the Team</a>
          <a href="#ourgoals" class="light button text-[#222222]">Our Goals</a>
          <a href="#donate" class="light button text-[#222222]">Donate Now</a>
          <a href="#faqs" class="light button text-[#222222]">FAQs</a>

            <SocialsAstroComponent />
          </div>

          <a href="/privacy" class="underline text-xl light">Privacy Policy</a>
        </div>

        <FooterMarquee client:visible/>
    </footer>

    <script type="module">
      import initAOS from '../components/AOSInit.ts'
      initAOS()
    </script>
  </body>
</html>
