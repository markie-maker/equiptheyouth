---
import Layout from "../layouts/Layout.astro"
import Section from "../layouts/Section.astro"
import Headline from "../components/headline.astro"
import DonationForm from "../components/donation-form.astro"
import AddressZoneChecker from '../components/address-zone-checker.svelte';
---

<Layout title="Equipment Donation">
    <Section is_under_nav={true}>
        <Headline title="Equipment Donation Form" description="Fill out the form below to get equipment to young athletes.">
            <div class="flex gap-4 flex-col">
                <p class="text-base md:text-xl text-[#222222] w-full">
                    Fill out this form to donate gear to Equip the Youth. We review items based on our condition criteria and will email you from <a href="mailto:info@equiptheyouth.org">info@equiptheyouth.org</a> once your photos are processed. Standard pickups are within our active service zones, but we can occasionally accommodate nearby locations. You can also check our map below or send us an email. Thank you for your support!
                </p>
            </div>
            <div class="flex gap-8 flex-col">
                <AddressZoneChecker client:only="svelte"/>
                <hr class="border-0 h-0 border-t border-t-black/10 border-b border-b-white/30">
                <DonationForm />
            </div>
        </Headline>
    </Section>
</Layout>